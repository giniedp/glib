mtllib cube.mtl
o Cube

# Vertices (v)
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

usemtl red
s off

# Back face (-Z)
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1

# Front face (+Z)
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# Bottom face (-Y)
f 1/1/3 2/3/3 6/2/3
f 1/1/3 6/2/3 5/4/3

# Top face (+Y)
f 4/1/4 7/3/4 3/2/4
f 4/1/4 8/4/4 7/3/4

# Left face (-X)
f 1/1/5 8/3/5 4/2/5
f 1/1/5 5/4/5 8/3/5

# Right face (+X)
f 2/1/6 7/3/6 6/2/6
f 2/1/6 3/4/6 7/3/6
