{
  "name": "gglib",
  "version": "0.6.2",
  "private": true,
  "description": "A Web GL Framework",
  "scripts": {
    "ws": "pnpm workspace",
    "glib": "pnpm -F glib",
    "glib:dev": "pnpm glib dev",
    "glib:test:watch": "gulp glib:watchTests",
    "glib:test:coverage": "IS_COVERAGE=yes gulp glib:test",
    "glib:test:coveralls": "IS_COVERAGE=yes gulp glib:test && cat ./coverage/lcov/lcov.info | ./node_modules/.bin/coveralls",
    "build": "gulp glib:build && gulp web:build",
    "lint": "pnpm lint:packages && pnpm lint:examples",
    "lint:packages": "eslint -c .eslintrc.js",
    "lint:examples": "tsc -p ./apps/web/src/tsconfig.json --noEmit",
    "dev": "concurrently -n ⬢,⬢ -c red,green -p '{name}' -k 'pnpm:glib:dev' 'pnpm:docs:dev'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "github.com/giniedp/glib.git"
  },
  "devDependencies": {
    "@gglib/content": "workspace:^0.6.2",
    "@gglib/content-loaders": "workspace:^0.6.2",
    "@gglib/ecs": "workspace:^0.6.2",
    "@gglib/components": "workspace:^0.6.2",
    "@gglib/materials": "workspace:^0.6.2",
    "@gglib/effects": "workspace:^0.6.2",
    "@gglib/graphics": "workspace:^0.6.2",
    "@gglib/input": "workspace:^0.6.2",
    "@gglib/math": "workspace:^0.6.2",
    "@gglib/particles": "workspace:^0.6.2",
    "@gglib/render": "workspace:^0.6.2",
    "@gglib/utils": "workspace:^0.6.2",
    "@types/globby": "^9.1.0",
    "@types/mithril": "^2.2.7",
    "@types/node": "^20.14.2",
    "@types/webgl2": "^0.0.11",
    "@typescript-eslint/eslint-plugin": "^4.31.2",
    "@typescript-eslint/parser": "^4.31.2",
    "@vitest/browser": "^3.1.3",
    "@webgpu/glslang": "^0.0.15",
    "@webgpu/types": "^0.1.60",
    "concurrently": "^9.1.2",
    "coveralls": "^3.1.1",
    "del": "^8.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsdoc": "^36.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "glob": "^11.0.2",
    "globby": "^14.1.0",
    "jslint": "^0.12.1",
    "lil-gui": "^0.20.0",
    "playwright": "^1.52.0",
    "ts-node": "^10.2.1",
    "tslib": "^2.8.1",
    "tweak-ui": "^0.4.3",
    "typescript": "^5.8.3",
    "vinyl": "^3.0.0",
    "vitepress": "^1.6.3",
    "vitepress-sidebar": "^1.31.1",
    "vitest": "^3.1.3",
    "vue": "^3.5.13",
    "webidl2ts": "^1.0.1",
    "yargs": "^17.2.0"
  },
  "keywords": [
    "webgl",
    "2d",
    "3d",
    "graphics"
  ],
  "author": "Alexander Graefenstein",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.1.2"
}
