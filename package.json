{
  "name": "gglib",
  "version": "0.7.0",
  "private": true,
  "description": "A Web GL Framework",
  "scripts": {
    "ws": "pnpm workspace",
    "glib": "pnpm -F glib",
    "glib:dev": "pnpm glib dev",
    "nw-viewer": "pnpm -F nw-viewer",
    "nw-viewer:dev": "pnpm nw-viewer dev",
    "nw-viewer:build": "pnpm nw-viewer build",
    "test": "pnpm vitest",
    "bench": "pnpm vitest bench",
    "clean": "rimraf -g \"**/node_modules\" \"**/dist\" \"**/*.tsbuildinfo\"",
    "build": "gulp glib:build && gulp web:build",
    "dev": "concurrently -n ⬢,⬢ -c red,green -p '{name}' -k 'pnpm:glib:dev' 'pnpm:docs:dev'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev:nw-viewer": "concurrently -n ⬢,⬢ -c red,green -p '{name}' -k 'pnpm:glib:dev' 'pnpm:nw-viewer:dev'",
    "capture": "pnpm dlx tsx ./tools/capture-thumbnails.mts"
  },
  "repository": {
    "type": "git",
    "url": "github.com/giniedp/glib.git"
  },
  "devDependencies": {
    "@gglib/components": "workspace:^0.7.0",
    "@gglib/content": "workspace:^0.7.0",
    "@gglib/ecs": "workspace:^0.7.0",
    "@gglib/effects": "workspace:^0.7.0",
    "@gglib/game": "workspace:^0.7.0",
    "@gglib/graphics": "workspace:^0.7.0",
    "@gglib/loaders": "workspace:^0.7.0",
    "@gglib/math": "workspace:^0.7.0",
    "@gglib/model": "workspace:^0.7.0",
    "@gglib/particles": "workspace:^0.7.0",
    "@gglib/render": "workspace:^0.7.0",
    "@gglib/utils": "workspace:^0.7.0",
    "@gglib/viewer": "workspace:^0.7.0",
    "@tweakpane/core": "^2.0.5",
    "@types/globby": "^9.1.0",
    "@types/mithril": "^2.2.7",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/webgl2": "^0.0.12",
    "@types/webxr": "^0.5.24",
    "@typescript-eslint/eslint-plugin": "^4.31.2",
    "@typescript-eslint/parser": "^4.31.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@webgpu/glslang": "^0.0.15",
    "@webgpu/types": "^0.1.69",
    "ammojs-typed": "^1.0.6",
    "concurrently": "^9.2.1",
    "coveralls": "^3.1.1",
    "del": "^8.0.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsdoc": "^36.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "glob": "^11.0.2",
    "globby": "^14.1.0",
    "highlight.js": "^11.11.1",
    "jslint": "^0.12.1",
    "lil-gui": "^0.21.0",
    "playwright": "^1.61.1",
    "prismjs": "^1.30.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.2.1",
    "tslib": "^2.8.1",
    "tweak-ui": "file:../tweak-ui",
    "typescript": "^5.9.3",
    "vinyl": "^3.0.1",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitepress-sidebar": "^1.36.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "webidl2ts": "^1.0.1",
    "yargs": "^18.0.0"
  },
  "keywords": [
    "webgl",
    "2d",
    "3d",
    "graphics"
  ],
  "author": "Alexander Graefenstein",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.1.2",
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    }
  }
}
