{
  "extends": "../tsconfig.tsc.json",
  "rootDir": ".",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist"
  },
  "include": [
    "./index.ts",
    "./src/**/*.ts",
    "./src/**/*.js"
  ],
  "exclude": [
    "./dist/**/*",
    "./node_modules/**/*",
    "./**/*.spec.ts",
    "./**/*.spec.js",
    "./**/*.test.ts",
    "./**/*.test.js",
    "./**/*.bench.ts",
    "./**/*.bench.js"
  ],
  "references": [
    {
      "path": "../utils/tsconfig.build.json"
    },
    {
      "path": "../math/tsconfig.build.json"
    }
  ]
}