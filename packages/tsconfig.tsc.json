{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "incremental": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": true,
    "lib": ["ESNext", "dom"],
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "target": "ES6",
    "allowJs": true,
    "typeRoots": [
      "../node_modules",
      "../types"
    ],
    "types": [
      "@types/webgl2",
      "gpuweb",
      "webxr"
    ]
  }
}
